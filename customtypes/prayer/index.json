{
  "id": "prayer",
  "label": "Prayer",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": "Nhập tiêu đề kinh nguyện..."
        }
      },
      "category": {
        "type": "Link",
        "config": {
          "label": "Category Link",
          "select": "document",
          "customtypes": ["category"],
          "placeholder": "Chọn danh mục liên kết..."
        }
      },
      "content": {
        "type": "StructuredText",
        "config": {
          "label": "Content",
          "placeholder": "Nhập nội dung lời kinh...",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink"
        }
      },
      "is_novena": {
        "type": "Boolean",
        "config": {
          "label": "Is Novena?",
          "placeholder_true": "Đúng (Là Tuần Cửu Nhật)",
          "placeholder_false": "Không",
          "default_value": false
        }
      },
      "novena_days": {
        "type": "Group",
        "config": {
          "label": "Novena Days (9 Days)",
          "fields": {
            "day": {
              "type": "Number",
              "config": {
                "label": "Day Index (1-9)",
                "placeholder": "Ví dụ: 1"
              }
            },
            "day_title": {
              "type": "Text",
              "config": {
                "label": "Day Title",
                "placeholder": "Ví dụ: Ngày 1: Suy niệm về..."
              }
            },
            "day_content": {
              "type": "StructuredText",
              "config": {
                "label": "Day Content",
                "placeholder": "Nhập nội dung kinh cho ngày này...",
                "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink"
              }
            }
          }
        }
      }
    }
  }
}
