rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collection users: lưu thông tin cá nhân, danh sách yêu thích, vai trò
    match /users/{userId} {
      allow read, write: if true;
    }

    // Collection edit_requests: lưu lịch sử yêu cầu chỉnh sửa từ người dùng
    match /edit_requests/{requestId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
