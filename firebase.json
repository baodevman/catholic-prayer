{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/submit-prayer",
        "function": "submitPrayer"
      },
      {
        "source": "/api/subscribe-to-alerts",
        "function": "subscribeToAlerts"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
